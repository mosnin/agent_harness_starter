{
  "name": "nextjs-agentic-starter",
  "version": "0.1.0",
  "private": false,
  "description": "Agentic Next.js starter kit \u2014 OpenAI Agents SDK, MCP, Composio, Tavily, sandboxes, and swappable DB/auth adapters",
  "exports": {
    ".":             { "import": "./dist/agents/index.js", "require": "./dist/agents/index.cjs" },
    "./memory":      { "import": "./dist/agents/memory/index.js", "require": "./dist/agents/memory/index.cjs" },
    "./governance":  { "import": "./dist/agents/governance/index.js", "require": "./dist/agents/governance/index.cjs" },
    "./security":    { "import": "./dist/agents/security/index.js", "require": "./dist/agents/security/index.cjs" },
    "./workflow":    { "import": "./dist/agents/workflow/index.js", "require": "./dist/agents/workflow/index.cjs" },
    "./tools":       { "import": "./dist/agents/tools/index.js", "require": "./dist/agents/tools/index.cjs" },
    "./skills":      { "import": "./dist/agents/skills/index.js", "require": "./dist/agents/skills/index.cjs" },
    "./definitions": { "import": "./dist/agents/definitions/index.js", "require": "./dist/agents/definitions/index.cjs" },
    "./observability": { "import": "./dist/agents/observability/index.js", "require": "./dist/agents/observability/index.cjs" },
    "./routing":     { "import": "./dist/agents/routing/index.js", "require": "./dist/agents/routing/index.cjs" }
  },
  "main": "./dist/agents/index.cjs",
  "module": "./dist/agents/index.js",
  "types": "./dist/agents/index.d.ts",
  "files": ["dist/", "src/agents/", "QUICKSTART.md", "docs/"],
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@openai/agents": ">=0.0.11",
    "@anthropic-ai/sdk": ">=0.39.0",
    "zod": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk":            { "optional": true },
    "@auth0/nextjs-auth0":          { "optional": true },
    "@clerk/nextjs":                { "optional": true },
    "@daytonaio/sdk":               { "optional": true },
    "@modelcontextprotocol/sdk":    { "optional": true },
    "@pinecone-database/pinecone":  { "optional": true },
    "@prisma/client":               { "optional": true },
    "@supabase/supabase-js":        { "optional": true },
    "@upstash/redis":               { "optional": true },
    "composio-core":                { "optional": true },
    "convex":                       { "optional": true },
    "modal":                        { "optional": true },
    "openai":                       { "optional": true }
  },
  "dependencies": {
    "@browserbasehq/sdk": "^2.10.0",
    "@tavily/core": "^0.7.3",
    "ai": "^6.0.174",
    "eventsource-parser": "^3.0.1",
    "next": "15.3.1",
    "playwright-core": "^1.59.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.53.0",
    "@openai/agents": "^0.8.5",
    "@tailwindcss/postcss": "^4.1.4",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "composio-core": "^0.5.39",
    "eslint": "^9.25.1",
    "eslint-config-next": "^15.3.1",
    "openai": "^4.100.0",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5",
    "zod": "^4.0.0"
  },
  "optionalDependencies": {
    "@auth0/nextjs-auth0": "^4.19.0",
    "@clerk/nextjs": "^7.3.0",
    "@daytonaio/sdk": "^0.171.0",
    "@pinecone-database/pinecone": "^6.0.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.105.1",
    "convex": "^1.37.0",
    "modal": "^0.7.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
