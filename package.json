      "optional": true
    },
    "@upstash/redis": {
      "optional": true
    },
    "composio-core": {
      "optional": true
    },
    "convex": {
      "optional": true
    },
    "modal": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "dependencies": {
