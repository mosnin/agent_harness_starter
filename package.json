{
  "name": "nextjs-agentic-starter",
  "version": "0.1.0",
  "private": false,
  "description": "Agentic Next.js starter kit — OpenAI Agents SDK, MCP, Composio, Tavily, sandboxes, and swappable DB/auth adapters",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./memory": {
      "import": "./dist/memory/index.js",
      "require": "./dist/memory/index.cjs"
    },
    "./governance": {
      "import": "./dist/governance/index.js",
      "require": "./dist/governance/index.cjs"
    },
    "./security": {
      "import": "./dist/security/index.js",
      "require": "./dist/security/index.cjs"
    },
    "./workflow": {
      "import": "./dist/workflow/index.js",
      "require": "./dist/workflow/index.cjs"
    },
    "./tools": {
      "import": "./dist/tools/index.js",
      "require": "./dist/tools/index.cjs"
    },
    "./skills": {
      "import": "./dist/skills/index.js",
      "require": "./dist/skills/index.cjs"
    },
    "./definitions": {
      "import": "./dist/definitions/index.js",
      "require": "./dist/definitions/index.cjs"
    },
    "./observability": {
      "import": "./dist/observability/index.js",
      "require": "./dist/observability/index.cjs"
    },
    "./routing": {
      "import": "./dist/routing/index.js",
      "require": "./dist/routing/index.cjs"
    },
    "./errors": {
      "import": "./dist/errors/index.js",
      "require": "./dist/errors/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "src/agents/",
    "QUICKSTART.md",
    "docs/"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:lib": "tsup",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.39.0",
    "@openai/agents": ">=0.0.11",
    "zod": ">=3.0.0"
