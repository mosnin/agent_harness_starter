      "types": "./dist/federation/index.d.ts"
    },
    "./codex": {
      "import": "./dist/codex/index.mjs",
      "require": "./dist/codex/index.js",
      "types": "./dist/codex/index.d.ts"
    },
    "./swarm-runtime": {
      "import": "./dist/swarm-runtime/index.mjs",
      "require": "./dist/swarm-runtime/index.js",
      "types": "./dist/swarm-runtime/index.d.ts"
    }
