  "files": [
    "dist",
    "src/agents",
    "routes",
    "scripts",
    "docs",
    "QUICKSTART.md",
    ".env.example",
    "dist-swarm",
    "docker",
    "docker-compose.swarm.yml",
    "ARCHITECTURE.md"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:lib": "tsup",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "test:watch": "vitest",
    "build:swarm": "node scripts/build-swarm.mjs",
    "swarm": "tsx src/swarm-runtime/cli.ts",
    "swarm:dashboard": "tsx src/swarm-runtime/cli.ts serve",
    "swarm:demo": "tsx examples/swarm/demo.ts",
    "swarm:bench": "tsx examples/swarm/bench.ts",
    "hades": "tsx src/hades/bin/hades.ts",
    "exec:bench": "tsx src/hades/bin/hades.ts exec bench",
    "tui": "tsx src/hades/bin/hades.ts tui",
    "desktop:build:sidecar": "node scripts/build-sidecar.mjs",
    "desktop:build:ui": "node scripts/build-desktop.mjs",
    "desktop:build": "npm run desktop:build:sidecar && npm run desktop:build:ui",
    "desktop:dev": "npm run desktop:build && cargo tauri dev --features gui",
    "package:desktop": "node scripts/package-desktop.mjs"
  },
  "peerDependencies": {
    "@openai/agents": ">=0.0.1",
    "openai": ">=4.0.0",
    "zod": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@tavily/core": {
      "optional": true
    },
    "@pinecone-database/pinecone": {
      "optional": true
    }
  },
  "dependencies": {
    "@noble/ed25519": "^3.1.0",
    "ai": "^6.0.174",
    "eventsource-parser": "^3.0.1",
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.53.0",
    "@openai/agents": "^0.8.5",
    "@tailwindcss/postcss": "^4.1.4",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "composio-core": "^0.5.39",
    "dotenv": "^17.4.2",
    "eslint": "^9.25.1",
    "eslint-config-next": "^15.3.1",
    "next": "15.3.1",
    "openai": "^4.100.0",
    "prisma": "^7.8.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwindcss": "^4.1.4",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5",
    "zod": "^4.0.0",
    "tsx": "^4.19.0"
  },
  "optionalDependencies": {
    "@auth0/nextjs-auth0": "^4.19.0",
    "@browserbasehq/sdk": "^2.10.0",
    "@clerk/nextjs": "^7.3.0",
    "@daytonaio/sdk": "^0.171.0",
    "@pinecone-database/pinecone": "^6.0.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.105.1",
    "@tavily/core": "^0.7.3",
    "convex": "^1.37.0",
    "modal": "^0.7.4",
    "playwright-core": "^1.59.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "hermes-swarm": "./dist-swarm/cli.js"
  }
}
