    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "composio-core": "^0.5.39",
    "eslint": "^9.25.1",
    "eslint-config-next": "^15.3.1",
    "openai": "^4.100.0",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.1.4",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5",
    "zod": "^4.0.0"
