# ============================================================
# NEXTJS AGENTIC STARTER — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.
# ============================================================

# ── Agent provider ──────────────────────────────────────────
# Which agent provider to use: "openai" | "anthropic"
# "openai"    — uses @openai/agents SDK with your own tool registry
# "anthropic" — uses Anthropic Managed Agents with built-in Bash/file/web tools
AGENT_PROVIDER=openai

# ── OpenAI (provider: openai) ────────────────────────────────
OPENAI_API_KEY=sk-...
# Default model for agents (optional, defaults to gpt-4o)
OPENAI_MODEL=gpt-4o

# ── Anthropic Managed Agents (provider: anthropic) ───────────
# Create agents + environments at https://platform.claude.com
# Beta docs: https://platform.claude.com/docs/en/managed-agents/overview
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_AGENT_ID=ag_...
ANTHROPIC_ENVIRONMENT_ID=env_...
# Optional: reuse an existing session across requests
ANTHROPIC_SESSION_ID=

# ── Memory provider ─────────────────────────────────────────
# Which memory/RAG backend to use: "memory" | "pgvector" | "pinecone"
MEMORY_PROVIDER=memory
# Pinecone (MEMORY_PROVIDER=pinecone)
PINECONE_API_KEY=
PINECONE_INDEX=agent-memory

# ── Tavily (web search) ─────────────────────────────────────
TAVILY_API_KEY=tvly-...

# ── Composio (3rd-party tool OAuth) ────────────────────────
COMPOSIO_API_KEY=...
# Optional: default Composio entity/user ID
COMPOSIO_ENTITY_ID=default

# ── Browserbase (parallel agentic browsers) ─────────────────
BROWSERBASE_API_KEY=...
BROWSERBASE_PROJECT_ID=...

# ── Daytona (sandbox) ───────────────────────────────────────
# Set SANDBOX_PROVIDER=daytona to use Daytona
DAYTONA_API_KEY=...
DAYTONA_SERVER_URL=https://app.daytona.io/api

# ── Modal (sandbox) ─────────────────────────────────────────
# Set SANDBOX_PROVIDER=modal to use Modal
# Modal uses token stored via `modal token new` CLI
MODAL_TOKEN_ID=...
MODAL_TOKEN_SECRET=...

# ── Sandbox selection ───────────────────────────────────────
# Which sandbox provider to use: "daytona" | "modal" | "none"
SANDBOX_PROVIDER=daytona

# ── Database ────────────────────────────────────────────────
# Which DB adapter to use: "supabase" | "convex" | "prisma"
DB_PROVIDER=supabase

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...

# Convex
NEXT_PUBLIC_CONVEX_URL=https://xxxx.convex.cloud

# Prisma (any DATABASE_URL supported by Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# ── Authentication ───────────────────────────────────────────
# Which auth provider to use: "clerk" | "auth0" | "none"
AUTH_PROVIDER=clerk

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Auth0
AUTH0_SECRET=...
AUTH0_BASE_URL=http://localhost:3000
AUTH0_ISSUER_BASE_URL=https://xxxx.auth0.com
AUTH0_CLIENT_ID=...
AUTH0_CLIENT_SECRET=...

# ── MCP ─────────────────────────────────────────────────────
# JSON array of external MCP server configs (optional)
# Each entry: { "name": string, "url": string, "apiKey"?: string }
MCP_SERVERS=[]

# ── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shared secret for internal API routes
API_SECRET=change-me-to-a-random-secret

# ── Capability tokens (security) ────────────────────────────
# HS256 (development): min 32 chars
# Token signing secret — used to sign per-run agent credentials (like API keys, but scoped and short-lived)
AGENT_CAPABILITY_SECRET=change-me-to-a-32-char-secret-here

# For production: use asymmetric keys (RS256) so the issuer and verifier can be separate services
# RS256 (production): generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
# AGENT_CAPABILITY_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# AGENT_CAPABILITY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Token TTL (default: 15m)
# AGENT_CAPABILITY_DEFAULT_TTL=15m

# Replay prevention — tracks used token IDs. In-process by default (lost on restart). Use redis for multi-instance deployments
# JTI revocation store (production: use redis)
# AGENT_JTI_STORE=redis
# REDIS_URL=redis://localhost:6379

# ── hades chat (the REPL / --once one-shot) ─────────────────
# Provider selection mirrors the rest of the CLI: ANTHROPIC_API_KEY is
# preferred, then OPENAI_API_KEY. With NEITHER set, `hades chat` answers as a
# self-announcing [mock] echo — it never fabricates a model answer.
# Override the model for chat only:
HADES_CHAT_MODEL=
# Point either provider at a proxy, gateway, or local OpenAI-compatible server.
# Both are honored by chat, `hades showdown live` and `hades bench`.
ANTHROPIC_BASE_URL=
OPENAI_BASE_URL=

# ── swarm engine (hermes-swarm run) ─────────────────────────
# The swarm CLI selects a real model when a provider key is present; flags
# (--provider/--model/--base-url/--offline) win over these. A configured
# provider whose key is missing is a hard error, never a silent mock.
SWARM_PROVIDER=
SWARM_MODEL=
