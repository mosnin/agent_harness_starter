{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hades",
  "version": "0.1.0",
  "identifier": "ai.hades.desktop",
  "build": {
    "frontendDist": "../dist/desktop",
    "beforeBuildCommand": "node scripts/check-helm-provenance.mjs && npm run desktop:build",
    "beforeDevCommand": "npm run desktop:build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Hades",
        "width": 1240,
        "height": 820,
        "minWidth": 800,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 22
        },
        "backgroundThrottling": "disabled",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; script-src 'self'; connect-src ipc: http://ipc.localhost; frame-src 'self' https: http://localhost:* http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": {
      "../dist/desktop/sidecar-entry.js": "sidecar-entry.js",
      "../dist/runtime/node": "node",
      "../dist/runtime/hades-pty": "hades-pty",
      "runtime-package.json": "package.json",
      "../dist/runtime/helm-opencode": "helm-opencode",
      "../dist/helm-ui/": "helm-ui/"
    },
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
